    "import numpy as np\n",
    "import os\n",
    "from scipy.stats import rankdata\n",
    "\n",
    "# Define file paths\n",
    "file_paths = {\n",
    "    \"DINO\": [f\"exports/unet/dino_np/dino_fdnzv5c2_e399_per_image_iou_fold{i}.npy\" for i in range(1, 6)],\n",
    "    \"ResNet50\": [f\"exports/unet/resnet_np/resnet50_per_image_iou_fold{i}.npy\" for i in range(1, 6)],\n",
    "    \"Baseline\": [f\"exports/baseline/baseline_np/per_image_iou_fold{i}_baseline.npy\" for i in range(1, 6)],\n",
    "}\n",
    "\n",
    "# Load IoU data with image IDs\n",
    "iou_data = {}\n",
    "for model, paths in file_paths.items():\n",
    "    ious = []\n",
    "    for p in paths:\n",
    "        if os.path.exists(p):\n",
    "            fold_data = np.load(p, allow_pickle=True)\n",
    "            ious.extend(fold_data)\n",
    "        else:\n",
    "            print(f\"Warning: File not found: {p}\")\n",
    "    iou_data[model] = dict(ious)  # map from image_id to IoU\n",
    "\n",
    "# Intersect IDs across all models to ensure consistent comparison\n",
    "common_ids = set.intersection(*[set(d.keys()) for d in iou_data.values()])\n",
    "\n",
    "# Extract aligned IoU arrays\n",
    "aligned_ious = {\n",
    "    model: np.array([iou_data[model][img_id] for img_id in sorted(common_ids)])\n",
    "    for model in iou_data\n",
    "}\n",
    "\n",
    "# Print mean and standard deviation for each model\n",
    "print(\"\\nMean and Standard Deviation IoU per model (on common images only):\")\n",
    "for model, ious in aligned_ious.items():\n",
    "    mean_iou = np.mean(ious)\n",
    "    std_iou = np.std(ious, ddof=1)\n",
    "    print(f\"{model}: Mean = {mean_iou:.4f}, Std = {std_iou:.4f}\")\n",
    "\n",
    "# Compute average ranks\n",
    "all_iou_stacked = np.vstack([aligned_ious[m] for m in [\"DINO\", \"ResNet50\", \"Baseline\"]]).T\n",
    "ranks = np.array([rankdata(-row, method='average') for row in all_iou_stacked])\n",
    "mean_ranks = np.mean(ranks, axis=0)\n",
    "\n",
    "print(\"\\nAverage Rank per Image (lower is better):\")\n",
    "for i, model in enumerate([\"DINO\", \"ResNet50\", \"Baseline\"]):\n",
    "    print(f\"{model}: Average Rank = {mean_ranks[i]:.4f}\")"
   ]
  },
