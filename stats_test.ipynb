    "#### Normality Test and Q-Q Plots for IoU Scores\n",
    "\n",
    "# Initialize lists to store IoU scores\n",
    "dino_scores = []\n",
    "resnet_scores = []\n",
    "baseline_scores = []\n",
    "\n",
    "# Load per-image IoU scores from 5 folds\n",
    "for fold in range(1,6):\n",
    "    dino_path = f\"exports/unet/dino_np/dino_fdnzv5c2_e399_per_image_iou_fold{fold}.npy\"\n",
    "    resnet_path = f\"exports/unet/resnet_np/resnet50_per_image_iou_fold{fold}.npy\"\n",
    "    baseline_path = f\"exports/baseline/baseline_np/per_image_iou_fold{fold}_baseline.npy\"\n",
    "\n",
    "    dino_scores.extend(np.load(dino_path))\n",
    "    resnet_scores.extend(np.load(resnet_path))\n",
    "    baseline_scores.extend(np.load(baseline_path))\n",
    "\n",
    "# Run Shapiro-Wilk test for normality\n",
    "shapiro_dino = stats.shapiro(dino_scores)\n",
    "shapiro_resnet = stats.shapiro(resnet_scores)\n",
    "shapiro_baseline = stats.shapiro(baseline_scores)\n",
    "\n",
    "# Create Q-Q plots to visually assess normality\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
    "stats.probplot(dino_scores, dist=\"norm\", plot=axes[0])\n",
    "axes[0].set_title(\"DINO Q-Q Plot\")\n",
    "\n",
    "stats.probplot(resnet_scores, dist=\"norm\", plot=axes[1])\n",
    "axes[1].set_title(\"ResNet Q-Q Plot\")\n",
    "\n",
    "stats.probplot(baseline_scores, dist=\"norm\", plot=axes[2])\n",
    "axes[2].set_title(\"Baseline Q-Q Plot\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Print Shapiro-Wilk test results\n",
    "print(\"Shapiro-Wilk Test Results:\")\n",
    "print(f\"DINO:     W={shapiro_dino.statistic:.4f}, p={shapiro_dino.pvalue:.4f}\")\n",
    "print(f\"ResNet50: W={shapiro_resnet.statistic:.4f}, p={shapiro_resnet.pvalue:.4f}\")\n",
    "print(f\"Baseline: W={shapiro_baseline.statistic:.4f}, p={shapiro_baseline.pvalue:.4f}\")"
