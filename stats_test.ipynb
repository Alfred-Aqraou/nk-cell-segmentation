    "from scipy.stats import friedmanchisquare\n",
    "\n",
    "# Initialize lists to collect IoU scores across folds\n",
    "all_dino = []\n",
    "all_resnet = []\n",
    "all_baseline = []\n",
    "\n",
    "# Collect IoU scores across folds\n",
    "for fold in range(1, 6):\n",
    "    iou_dino      = np.load(f\"exports/unet/dino_np/dino_fdnzv5c2_e399_per_image_iou_fold{fold}.npy\")\n",
    "    iou_resnet50  = np.load(f\"exports/unet/resnet_np/resnet50_per_image_iou_fold{fold}.npy\")\n",
    "    iou_baseline  = np.load(f\"exports/baseline/baseline_np/per_image_iou_fold{fold}_baseline.npy\")\n",
    "    \n",
    "    # Sanity check\n",
    "    assert len(iou_dino) == len(iou_resnet50) == len(iou_baseline), f\"Mismatch in fold {fold}\"\n",
    "\n",
    "    all_dino.extend(iou_dino)\n",
    "    all_resnet.extend(iou_resnet50)\n",
    "    all_baseline.extend(iou_baseline)\n",
    "\n",
    "# Convert to numpy arrays\n",
    "all_dino = np.array(all_dino)\n",
    "all_resnet = np.array(all_resnet)\n",
    "all_baseline = np.array(all_baseline)\n",
    "\n",
    "# Run Friedman test across all images\n",
    "statistic, p_value = friedmanchisquare(all_dino, all_resnet, all_baseline)\n",
    "\n",
    "# Print results\n",
    "print(f\"Friedman test statistic: {statistic:.4f}, p-value: {p_value:.15f}\")\n",
    "\n",
    "# Interpret result\n",
    "alpha = 0.05\n",
    "if p_value < alpha:\n",
    "    print(\"→ Significant differences between models (reject H0)\")\n",
    "else:\n",
    "    print(\"→ No significant differences between models (fail to reject H0)\")"
   ]
  },
