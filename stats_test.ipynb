    "######NEW Boxplot for bootstrapped mean IoU across different models#####\n",
    "\n",
    "# Set seed for reproducibility\n",
    "np.random.seed(42)\n",
    "\n",
    "# Load all IoU scores\n",
    "iou_data = {model: [] for model in paths}\n",
    "for model, model_paths in paths.items():\n",
    "    for path in model_paths:\n",
    "        ious = np.load(path)\n",
    "        iou_data[model].extend(ious)\n",
    "\n",
    "# Bootstrap the mean IoU scores\n",
    "bootstrapped_means = {model: [] for model in iou_data}\n",
    "n_iterations = 1000\n",
    "sample_size = len(iou_data[\"DINO\"])  # Average per fold\n",
    "\n",
    "\n",
    "\n",
    "for model, scores in iou_data.items():\n",
    "    scores = np.array(scores)\n",
    "    for _ in range(n_iterations):\n",
    "        sample = np.random.choice(scores, size=sample_size, replace=True)\n",
    "        bootstrapped_means[model].append(np.mean(sample))\n",
    "\n",
    "# Create boxplot\n",
    "colors = ['#4C72B0', '#55A868', '#C44E52']  # blue, green, red\n",
    "plt.figure(figsize=(10, 6))\n",
    "box = plt.boxplot(bootstrapped_means.values(), labels=bootstrapped_means.keys(), patch_artist=True)\n",
    "\n",
    "# Set custom colors\n",
    "for patch, color in zip(box['boxes'], colors):\n",
    "    patch.set_facecolor(color)\n",
    "    patch.set_edgecolor('black')\n",
    "    patch.set_linewidth(1.2)\n",
    "\n",
    "# Style adjustments\n",
    "plt.ylabel(\"Bootstrapped Mean IoU\", fontsize=12)\n",
    "plt.title(\"Bootstrapped Box Plots of Mean IoU Scores Across Models\", fontsize=14)\n",
    "plt.xticks(fontsize=11)\n",
    "plt.yticks(fontsize=11)\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
