    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.utils import resample\n",
    "\n",
    "# Use a clean seaborn style\n",
    "sns.set(style=\"whitegrid\", context=\"talk\")\n",
    "\n",
    "# Provided means and stds for the top 3 configurations\n",
    "means = [84.79, 84.70, 84.56]\n",
    "stds = [2.024, 1.945, 1.505]\n",
    "config_labels = ['Config 1', 'Config 2', 'Config 3']\n",
    "\n",
    "# Number of folds (samples per config)\n",
    "n_folds = 5\n",
    "n_bootstrap = 10000\n",
    "confidence_level = 0.95\n",
    "\n",
    "# Store bootstrapped sample means for boxplot\n",
    "bootstrapped_means_all = []\n",
    "\n",
    "# Seed for reproducibility\n",
    "np.random.seed(42)\n",
    "\n",
    "for mean, std in zip(means, stds):\n",
    "    # Simulate 5-fold samples\n",
    "    samples = np.random.normal(loc=mean, scale=std, size=n_folds)\n",
    "    \n",
    "    # Bootstrap resampling\n",
    "    boot_means = [np.mean(resample(samples)) for _ in range(n_bootstrap)]\n",
    "    bootstrapped_means_all.append(boot_means)\n",
    "\n",
    "# Plotting\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.boxplot(data=bootstrapped_means_all)\n",
    "plt.xticks(ticks=np.arange(len(config_labels)), labels=config_labels, fontsize=12)\n",
    "plt.ylabel('Mean IoU (%)', fontsize=14)\n",
    "plt.title('Bootstrapped Mean IoU for Top 3 DINO Configurations', fontsize=16)\n",
    "plt.grid(True, axis='y', linestyle='--', alpha=0.7)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
