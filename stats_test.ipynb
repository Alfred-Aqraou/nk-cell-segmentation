    "import numpy as np\n",
    "from scipy.stats import friedmanchisquare\n",
    "\n",
    "# Lists to store IoU values for all folds\n",
    "iou_dino_all = []\n",
    "iou_resnet50_all = []\n",
    "iou_baseline_all = []\n",
    "\n",
    "# Loop through folds and collect per-image IoU values\n",
    "for fold in range(1, 6):\n",
    "    iou_dino      = np.load(f\"exports/unet/dino_np/dino_fdnzv5c2_e399_per_image_iou_fold{fold}.npy\")\n",
    "    iou_resnet50  = np.load(f\"exports/unet/resnet_np/resnet50_per_image_iou_fold{fold}.npy\")\n",
    "    iou_baseline  = np.load(f\"exports/baseline/baseline_np/per_image_iou_fold{fold}_baseline.npy\")\n",
    "\n",
    "    # Ensure same image count per fold\n",
    "    assert len(iou_dino) == len(iou_resnet50) == len(iou_baseline), f\"Mismatch in fold {fold}!\"\n",
    "\n",
    "    iou_dino_all.extend(iou_dino)\n",
    "    iou_resnet50_all.extend(iou_resnet50)\n",
    "    iou_baseline_all.extend(iou_baseline)\n",
    "\n",
    "# Convert to numpy arrays\n",
    "iou_dino_all = np.array(iou_dino_all)\n",
    "iou_resnet50_all = np.array(iou_resnet50_all)\n",
    "iou_baseline_all = np.array(iou_baseline_all)\n",
    "\n",
    "# Run Friedman test\n",
    "statistic, p_value = friedmanchisquare(iou_dino_all, iou_resnet50_all, iou_baseline_all)\n",
    "\n",
    "# Print results\n",
    "print(f\"Friedman test statistic: {statistic:.4f}, p-value: {p_value:.4f}\")\n",
    "alpha = 0.05\n",
    "if p_value < alpha:\n",
    "    print(\"→ Significant differences between models (reject H₀)\")\n",
    "else:\n",
    "    print(\"→ No significant differences between models (fail to reject H₀)\")"
   ]
  },
