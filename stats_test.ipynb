    "#### Plotting the mean IoU with 95% confidence intervals\n",
    "\n",
    "means = np.array([0.8575,0.8553,0.8546,0.8536])\n",
    "stds  = np.array([0.0198,0.0120,0.0143,0.0229])\n",
    "n = 3\n",
    "\n",
    "# Calculate 95% CI\n",
    "sem = stds / np.sqrt(n)\n",
    "t_value = stats.t.ppf(0.975, df=n-1)\n",
    "ci_half_width = t_value * sem\n",
    "\n",
    "# Plot\n",
    "labels = [f'Config {i+1}' for i in range(len(means))]\n",
    "x_pos = np.arange(len(means))\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "plt.errorbar(x_pos, means, yerr=ci_half_width, fmt='o', capsize=10, capthick=2)\n",
    "plt.xticks(x_pos, labels)\n",
    "plt.ylabel('IoU Score')\n",
    "plt.title('Mean IoU with 95% Confidence Intervals')\n",
    "plt.grid(True, axis='y')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
